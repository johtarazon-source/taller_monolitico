APP_ENV=local

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alquiler_vehiculos_db
DB_USERNAME=root
DB_PASSWORD=

# Usuario administrador de la API. El hash se genera con:
#   php -r "echo password_hash('TuClave', PASSWORD_DEFAULT);"
# y se pega entre comillas simples, para que el signo $ no se interprete:
#   ADMIN_PASSWORD_HASH='$2y$10$...'
ADMIN_USER=Admin
ADMIN_PASSWORD_HASH=

APP_TOKEN_TTL_MINUTES=120

# Origenes permitidos para consumir la API (/api) desde otro dominio, separados por coma.
# No hace falta si el frontend se sirve desde el mismo origen que el backend (XAMPP).
CORS_ALLOWED_ORIGIN=http://localhost

APP_TIMEZONE=America/Bogota

# Opcional: ruta del archivo donde se guardan los tokens de sesion (por defecto sessions.json).
# SESSIONS_FILE=
